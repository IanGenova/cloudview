{
  "name": "cloud-view-mvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:https": "next dev --experimental-https -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start:http": "next start -H 0.0.0.0 -p 3001",
    "start:https": "concurrently \"npm run start:http\" \"local-ssl-proxy --hostname 192.168.0.130 --source 3000 --target 3001\"",
    "start": "npm run start:https",
    "lint": "eslint .",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@photo-sphere-viewer/core": "^5.14.1",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "centrifuge": "^5.6.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.41.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.9.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "local-ssl-proxy": "^2.0.5",
    "postcss": "^8.5.23",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
