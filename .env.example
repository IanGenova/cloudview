DATABASE_URL="mysql://cloudview_user:strong_password@localhost:3306/cloudview"
AUTH_SECRET="replace-with-a-long-random-secret"

# Public application URLs.
APP_URL=https://cloudhotelph.com
NEXT_PUBLIC_APP_URL=https://cloudhotelph.com

# A bare host, optionally with a port -- NOT a URL. next.config.mjs uses this
# directly as an image remotePattern hostname and builds http://<value>:3000
# from it, so a scheme here silently matches nothing.
#   correct:   192.168.0.130      cloudhotelph.com      192.168.0.130:3000
#   wrong:     https://cloudhotelph.com
NEXT_PUBLIC_LAN_IP=cloudhotelph.com

NEXT_PUBLIC_FORCE_HTTPS=false
POS_XENDIT_RETURN_URL=https://cloudhotelph.com

# The origin NFC launch links and guest redirects are built from, when it has
# to differ from APP_URL. Set this on any deployment that is not the canonical
# public domain -- a LAN or PM2 build, a staging host, a white-label instance.
#
# Without it, a production build whose APP_URL is a loopback or private address
# falls back to CloudView's own canonical origin, and guests are redirected off
# your deployment entirely. Loopback and LAN values are accepted here and only
# here, which is what makes this the override rather than APP_URL.
#
# NFC_PUBLIC_APP_URL=http://192.168.0.130:3000

# Comma-separated. Both are read by next.config.mjs and appended to the
# built-in localhost/LAN entries; leave unset for local development.
ALLOWED_DEV_ORIGINS=https://cloudhotelph.com
SERVER_ACTION_ALLOWED_ORIGINS=https://cloudhotelph.com

MOCK_POS_SHARED_SECRET=replace-with-a-random-development-secret
NFC_ACCESS_TTL_MINUTES=720
NFC_IDLE_TIMEOUT_MINUTES=360

# Bind an NFC guest session to the network it was opened from, so a stolen
# cv_nfc_access cookie replayed from elsewhere is rejected.
#
# Off by default, and that default is a real trade-off rather than an
# oversight: a guest whose phone moves between hotel wifi and mobile data
# changes address mid-stay and would be logged out. Turn it on where guests
# stay on one network. The session's ipHash is recorded either way, so
# enabling this costs nothing but the lockouts.
NFC_BIND_IP=false

# Guest room passcodes by SMS. The check-in screen offers to text the passcode
# and the room-passcode gate is on by default, so with SMS_ENABLED unset the
# offer silently does nothing.
SMS_ENABLED=false
SMS_PROVIDER=semaphore
SMS_SENDER_NAME=CloudView
SEMAPHORE_API_KEY=replace-with-your-semaphore-api-key
SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages
SEMAPHORE_SENDER_NAME=CloudView

# Where uploaded media is written and served from. These must agree: the menu
# uploader writes under MENU_UPLOAD_DIR and /api/menu-media reads from it. With
# both unset they now agree -- storage/menu-images in development,
# /var/www/cloudview-uploads/menu in production, which is what the nginx alias
# serves. They used to disagree, so uploads succeeded and every photo 404d.
CLOUDVIEW_MEDIA_ROOT=/var/www/cloudview-uploads
MENU_UPLOAD_DIR=/var/www/cloudview-uploads/menu

NEXT_PUBLIC_CENTRIFUGO_HOST=https://cloudhotelph.com
NEXT_PUBLIC_CENTRIFUGO_PORT=8000
NEXT_PUBLIC_CENTRIFUGO_PATH=/connection/websocket
NEXT_PUBLIC_CENTRIFUGO_WS_URL=ws://cloudhotelph.com:8000/connection/websocket
CENTRIFUGO_TOKEN_HMAC_SECRET=replace-with-a-long-random-secret
CENTRIFUGO_API_URL=http://127.0.0.1:8000/api
CENTRIFUGO_API_KEY=replace-with-a-random-api-key
CENTRIFUGO_HTTP_API_URL=http://127.0.0.1:8000/api
CENTRIFUGO_HTTP_API_KEY=replace-with-a-random-api-key

SCHEDULED_RELEASE_CRON_SECRET=replace-with-a-long-random-secret
SCHEDULED_RELEASE_INTERVAL_MS=60000

# Server-only Xendit credentials. Never expose these through NEXT_PUBLIC_*.
XENDIT_SECRET_KEY=xnd_development_replace_me
XENDIT_WEBHOOK_TOKEN=replace-with-the-token-from-xendit-webhook-settings
XENDIT_LIVEMODE=false

# Optional hosted-checkout channel restrictions. Leave empty to show every
# compatible channel activated on the Xendit account.
# Supported explicit values in this implementation:
# CARDS,GCASH,QRPH,SHOPEEPAY,GRABPAY,PAYMAYA
#
# XENDIT_PAYMENT_METHODS applies to staff-side checkouts (POS terminal and
# guest-stay folio); XENDIT_GUEST_PAYMENT_METHODS applies to the guest portal.
XENDIT_PAYMENT_METHODS=CARDS,GCASH,QRPH,SHOPEEPAY,GRABPAY,PAYMAYA
XENDIT_GUEST_PAYMENT_METHODS=GCASH,QRPH,SHOPEEPAY,GRABPAY,PAYMAYA

# CloudView master Business ID (24 hexadecimal characters) for xenPlatform.
# xenPlatform sub-accounts and Split Payments must be enabled by Xendit first.
XENDIT_MASTER_ACCOUNT_ID=5f27a14a9bf05c73dd040bc8

# Automatic refund/retry behavior.
#
# The retry endpoint is driven by the cloudview-refund-retry PM2 app in
# ecosystem.production.config.cjs. Without that app running, a refund that fails once
# stays FAILED forever and the guest's money is not returned.
XENDIT_AUTO_REFUND_ON_FULFILLMENT_FAILURE=true
XENDIT_REFUND_CRON_SECRET=replace-with-a-long-random-secret
XENDIT_REFUND_RETRY_INTERVAL_MS=300000
